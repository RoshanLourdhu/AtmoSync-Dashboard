# Example environment file for the Superset stack
# Copy this to .env (which should be ignored by git) and adjust values as needed.

# IMPORTANT: Replace placeholder passwords with strong, unique values before deployment.
# PostgreSQL credentials
POSTGRES_USER=superset
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=superset

# Redis password
REDIS_PASSWORD=change_this_redis_password

# Superset admin user (default credentials are admin/admin)
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change_this_admin_password
SUPERSET_ADMIN_FIRST_NAME=Admin
SUPERSET_ADMIN_LAST_NAME=User
SUPERSET_ADMIN_EMAIL=admin@localhost.com

# Optional: enable Snowflake connectivity later by adding the following line (do NOT uncomment now)
# SQLALCHEMY_URL=snowflake://<user>:<password>@<account>/<database>/<schema>

