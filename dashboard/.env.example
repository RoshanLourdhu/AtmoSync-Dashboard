# Example environment file for AtmoSync Superset Dashboard stack
# Copy this to .env (which is gitignored) and adjust values as needed.
# NEVER commit real passwords or credentials.

# PostgreSQL credentials for Superset metadata database
POSTGRES_USER=superset
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=superset

# Redis password
REDIS_PASSWORD=change_this_redis_password

# Superset application secrets
SUPERSET_SECRET_KEY=change_this_to_a_random_32_char_secret_key

# Superset initial admin credentials
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change_this_admin_password
SUPERSET_ADMIN_FIRST_NAME=Admin
SUPERSET_ADMIN_LAST_NAME=User
SUPERSET_ADMIN_EMAIL=admin@localhost.com

# Target Snowflake database configuration (for reference when adding DB connection in Superset)
# Connection URI format:
# snowflake://{user}:{password}@{account}/{database}/{schema}?warehouse={warehouse}&role={role}
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=atmosync_svc
SNOWFLAKE_PASSWORD=change_this_snowflake_password
SNOWFLAKE_WAREHOUSE=ATMOSYNC_WH
SNOWFLAKE_DATABASE=ATMOSYNC_DB
SNOWFLAKE_SCHEMA=MARTS
SNOWFLAKE_ROLE=ATMOSYNC_INGEST_ROLE
