# Copy this file to .env and replace the placeholders locally.
# .env is gitignored. Do not commit real credentials.

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_SENSOR_DATA=container-sensor-data
KAFKA_CONSUMER_GROUP=atmosync-sensor-consumer
KAFKA_PRODUCER_CLIENT_ID=atmosync-sensor-producer
KAFKA_PRODUCER_ACKS=all
KAFKA_BATCH_SIZE=10
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Snowflake
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_DATABASE=ATMOSYNC_DB
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=your_role
