# Copy this file to .env and replace the placeholders locally.
# .env is gitignored. Do not commit real credentials.

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_SENSOR_DATA=container-sensor-data
KAFKA_CONSUMER_GROUP=atmosync-sensor-consumer
KAFKA_PRODUCER_CLIENT_ID=atmosync-sensor-producer
KAFKA_PRODUCER_ACKS=all
KAFKA_BATCH_SIZE=10
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Snowflake
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=ATMOSYNC_WH
SNOWFLAKE_DATABASE=ATMOSYNC_DB
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=your_role

# Apache Superset & Metadata DB (dashboard/)
POSTGRES_USER=superset
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=superset
REDIS_PASSWORD=your_redis_password
SUPERSET_SECRET_KEY=your_random_32_char_secret_key
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=your_admin_password
