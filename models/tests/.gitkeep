WITH commodity AS (

    SELECT *
    FROM {{ ref('stg_commodity') }}

),

spoilage AS (

    SELECT
        COMMODITY_ID,
        COMMODITY_NAME,
        CATEGORY,
        PRICE,
        QUANTITY,
        LOCATION,
        RECORDED_AT,

        CASE
            WHEN CATEGORY = 'Fruits' THEN 5
            WHEN CATEGORY = 'Vegetables' THEN 7
            WHEN CATEGORY = 'Grains' THEN 30
            ELSE NULL
        END AS SHELF_LIFE_DAYS

    FROM commodity

)

SELECT *
FROM spoilage